<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>

<!--
    PlateauView.fxml  –  plateau d'échecs 8x8
    Le GridPane #gridPlateau est rempli dynamiquement par ChessBoardCtrl.
    Pas de boutons statiques : tout est créé en Java.
-->
<BorderPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="application.ChessBoardCtrl"
    style="-fx-background-color: #2b2b2b;">

    <center>
        <!-- Le GridPane sera rempli de 64 SquareButton par le contrôleur -->
        <GridPane fx:id="gridPlateau"
                  style="-fx-padding: 20; -fx-hgap: 0; -fx-vgap: 0;" />
    </center>

    <bottom>
        <VBox style="-fx-padding: 8 20 12 20; -fx-spacing: 4;">
            <Label fx:id="labelStatut"
                   text="Cliquez sur une pièce pour voir ses déplacements"
                   style="-fx-text-fill: #cccccc; -fx-font-size: 14px;" />
        </VBox>
    </bottom>

</BorderPane>
